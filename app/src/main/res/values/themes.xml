<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GuardX" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.GuardX.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0F1C</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.GuardX</item>
    </style>
</resources>
